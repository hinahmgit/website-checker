# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" secret key. Server-only — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel login (/admin). Pick a long password.
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie (e.g. 40+ random characters).
ADMIN_SESSION_SECRET=

# Optional but recommended: Google PageSpeed Insights API key.
# Without it Google allows very few requests per day.
PAGESPEED_API_KEY=

# Time zone for "this month / this year" boundaries in the admin dashboard (IANA name).
ADMIN_TIMEZONE=Asia/Karachi

# Email alerts for new leads (https://resend.com → API Keys). Free tier: 3,000 emails/month.
RESEND_API_KEY=
# Where alerts go. Comma-separate several addresses.
LEAD_NOTIFY_EMAIL=
# Optional sender. Leave empty to use onboarding@resend.dev, which only delivers to the
# email you signed up to Resend with. To use e.g. alerts@yourdomain.com, verify your domain in Resend.
LEAD_FROM_EMAIL=
